<?xml version="1.0" encoding="utf-8" ?>
<resources>
  <!-- AppCompatActivity (Avalonia.Android) exige un thème AppCompat : sans lui, setContentView lève
       « IllegalStateException: You need to use a Theme.AppCompat theme (or descendant) with this activity » (journal d'un appareil réel).
       Même définition que samples/ControlCatalog.Android d'Avalonia (Resources/values/styles.xml). -->
  <style name="MyTheme.NoActionBar" parent="@style/Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:windowActionBar">false</item>
    <item name="android:windowNoTitle">true</item>
  </style>
</resources>
