<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tête ANDROID (vue unique, IActivityApplicationLifetime). Build : scripts/platforms.sh android (JDK + SDK Android requis). -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationId>net.fstar.mvu</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>
  <!-- NativeAOT sur Android (expérimental, voir docs/NATIVEAOT.md) : activé par -p:AndroidNativeAot=true avec un RID android-arm64 ou android-x64,
       le NDK r27+ (AndroidNdkDirectory) et EnablePreviewFeatures (avertissement XA1040). Par défaut : Mono AOT (APK multi-ABI). -->
  <PropertyGroup Condition="'$(AndroidNativeAot)' == 'true'">
    <PublishAot>true</PublishAot>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Android.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Shell/Shell.fsproj" />
    <PackageReference Include="Avalonia.Android" Version="12.1.4" />
  </ItemGroup>
</Project>
