<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tête iOS (vue unique, ISingleViewApplicationLifetime). NON COMPILÉE ICI : exige macOS + Xcode + le workload « ios »
       (indisponible sous Linux : `dotnet workload search ios` ne renvoie rien). Écrite d'après samples/ControlCatalog.iOS d'Avalonia 12.1.4.
       Build sur Mac : scripts/platforms.sh ios -->
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ProvisioningType>manual</ProvisioningType>
    <RootNamespace>HostIOS</RootNamespace>
    <!-- NativeAOT (docs/NATIVEAOT.md §5) : conditionné à la plateforme dans CE projet, jamais passé en -p:PublishAot=true global : il atteindrait les
         bibliothèques net10.0 (Shell, Ui, Extracted) et ferait échouer la restauration (run 40370127417 : « NETSDK1203: Ahead-of-time compilation is not
         supported for the target runtime identifier 'ios-arm64' »). -->
    <PublishAot Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">true</PublishAot>
    <!-- CONTOURNEMENT « inévitable » (défaut de l'outil, pas de notre code) : sans lui, la CI échoue (run 40362696619, .NET for iOS 26.0.11017, Xcode 26.0.1,
         FSharp.Core 10.1.403) : « Xamarin.Shared.Sdk.targets(1032,3): error : ILStrip failed for obj/Release/net10.0-ios/iossimulator-arm64/linked/FSharp.Core.dll:
         Object reference not set to an instance of an object ». Même message dans fabulous-dev/Fabulous#1355, qui cite ce contournement (cause exacte non confirmée).
         Coût : les assemblies gardent leur IL (application plus grosse). -->
    <EnableAssemblyILStripping>false</EnableAssemblyILStripping>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Main.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Shell/Shell.fsproj" />
    <PackageReference Include="Avalonia.iOS" Version="12.1.4" />
  </ItemGroup>
</Project>
